[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-asteroid-dodger
Exec=harbour-asteroid-dodger
Name=Dodger
Comment=A tilt controlled dodging game

[X-Sailjail]
# Sandboxed. The game reads the accelerometer (Sensors) and writes only
# its own config directory, ~/.config/net.mowerk/harbour-asteroid-dodger/.
OrganizationName=net.mowerk
ApplicationName=harbour-asteroid-dodger
Permissions=Sensors
